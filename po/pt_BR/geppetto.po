#: libs/versioning/KisVersioningFileRules.cpp
#: plugins/dockers/projectsdocker/ProjectsModel.cpp
msgid "1 file changed"
msgid_plural "%1 files changed"
msgstr[0] "1 arquivo alterado"
msgstr[1] "%1 arquivos alterados"

#: libs/versioning/KisVersioningSyncSession.cpp
#, kde-format
msgid "Could not save %1 before synchronising."
msgstr "Não foi possível salvar %1 antes de sincronizar."

#: libs/versioning/KisVersioningSyncSession.cpp
#, kde-format
msgid "Could not keep a copy of %1, so it was left as it is."
msgstr "Não foi possível guardar uma cópia de %1; o arquivo foi deixado como estava."

#: libs/versioning/KisVersioningSyncSession.cpp
#, kde-format
msgid "Could not mark the copy of %1 as a conflict to resolve, so it was left as it is."
msgstr "Não foi possível marcar a cópia de %1 como conflito a resolver; o arquivo foi deixado como estava."

#: libs/versioning/KisVersioningSyncSession.cpp
#, kde-format
msgid "%1 changed while it was being copied, so it was left as it is. Synchronise again."
msgstr "%1 mudou durante a cópia; o arquivo foi deixado como estava. Sincronize de novo."

#: plugins/versioning/localfolder/LocalFolderDriverPlugin.cpp
msgid "Folder on this computer"
msgstr "Pasta neste computador"

#: plugins/versioning/localfolder/LocalFolderDriver.cpp
#: plugins/versioning/lore/LoreOperation.cpp
msgid "The operation was cancelled."
msgstr "A operação foi cancelada."

#: plugins/versioning/localfolder/LocalFolderDriver.cpp
#: plugins/versioning/lore/LoreOperation.cpp
#, kde-format
msgid "The folder %1 does not exist."
msgstr "A pasta %1 não existe."

#: plugins/versioning/localfolder/LocalFolderDriver.cpp
#, kde-format
msgid "The versions kept in %1 could not be read."
msgstr "Não foi possível ler as versões guardadas em %1."

#: plugins/versioning/localfolder/LocalFolderDriver.cpp
#, kde-format
msgid "The new version could not be saved in %1."
msgstr "Não foi possível salvar a nova versão em %1."

#: plugins/versioning/localfolder/LocalFolderDriver.cpp
#, kde-format
msgid "%1 could not be read."
msgstr "Não foi possível ler %1."

#: plugins/versioning/localfolder/LocalFolderDriver.cpp
#, kde-format
msgid "%1 could not be copied."
msgstr "Não foi possível copiar %1."

#: plugins/versioning/localfolder/LocalFolderDriver.cpp
#, kde-format
msgid "%1 could not be written."
msgstr "Não foi possível gravar %1."

#: plugins/versioning/localfolder/LocalFolderDriver.cpp
#, kde-format
msgid "There is no version %1."
msgstr "Não existe a versão %1."

#: plugins/versioning/localfolder/LocalFolderDriver.cpp
#, kde-format
msgid "%1 does not exist in that version."
msgstr "%1 não existe nessa versão."

#: plugins/versioning/localfolder/LocalFolderDriver.cpp
msgid "Versions kept in a folder do not support this operation."
msgstr "Versões guardadas em uma pasta não oferecem suporte a esta operação."

#: plugins/versioning/localfolder/LocalFolderDriver.cpp
#, kde-format
msgid "The versions kept in %1 are being used by another program. Try again in a moment."
msgstr "As versões guardadas em %1 estão sendo usadas por outro programa. Tente de novo em instantes."

#: plugins/dockers/projectsdocker/ProjectsDock.cpp
msgid "Projects"
msgstr "Projetos"

#: plugins/dockers/projectsdocker/ProjectsDock.cpp
msgid "Projects are not available in this installation."
msgstr "Os projetos não estão disponíveis nesta instalação."

#: plugins/dockers/projectsdocker/ProjectsDock.cpp
msgid "Server address"
msgstr "Endereço do servidor"

#: plugins/dockers/projectsdocker/ProjectsDock.cpp
msgid "Sign in"
msgstr "Entrar"

#: plugins/dockers/projectsdocker/ProjectsDock.cpp
#, kde-format
msgid "%1 · signed in"
msgstr "%1 · sessão ativa"

#: plugins/dockers/projectsdocker/ProjectsDock.cpp
msgid "Add folder…"
msgstr "Adicionar pasta…"

#: plugins/dockers/projectsdocker/ProjectsDock.cpp
msgid "Choose a project folder"
msgstr "Escolha a pasta do projeto"

#: plugins/dockers/projectsdocker/ProjectsDock.cpp
msgid "Notes (optional)"
msgstr "Notas (opcional)"

#: plugins/dockers/projectsdocker/ProjectsDock.cpp
msgid "Synchronize"
msgstr "Sincronizar"

#: plugins/dockers/projectsdocker/ProjectsDock.cpp
msgid "1 open document will be saved"
msgid_plural "%1 open documents will be saved"
msgstr[0] "1 documento aberto será salvo"
msgstr[1] "%1 documentos abertos serão salvos"

#: plugins/dockers/projectsdocker/ProjectsDock.cpp
msgid "pending upload"
msgstr "pendente de envio"

#: plugins/dockers/projectsdocker/ProjectsDock.cpp
#, kde-format
msgid "Both versions of %1 were kept"
msgstr "As duas versões de %1 foram mantidas"

#: plugins/dockers/projectsdocker/ProjectsDock.cpp
#, kde-format
msgid ""
"%1 was replaced by the other version while you kept working. Save your work "
"under another name."
msgstr ""
"%1 foi trocado pela outra versão enquanto você continuava trabalhando. Salve "
"o seu trabalho com outro nome."

#: plugins/dockers/projectsdocker/ProjectsDock.cpp
msgid "Sign in again to send your work"
msgstr "Entre de novo para enviar o seu trabalho"

#: plugins/dockers/projectsdocker/ProjectsDock.cpp
msgid "Conflict resolved"
msgstr "Conflito resolvido"

#: plugins/dockers/projectsdocker/ProjectsModel.cpp
msgid "changed"
msgstr "alterado"

#: plugins/dockers/projectsdocker/ProjectsModel.cpp
msgid "new"
msgstr "novo"

#: plugins/dockers/projectsdocker/ProjectsModel.cpp
msgid "removed"
msgstr "removido"

#: plugins/dockers/projectsdocker/ProjectsModel.cpp
#, kde-format
msgid "%1 editing"
msgstr "%1 editando"

#: plugins/dockers/projectsdocker/ProjectsModel.cpp
msgid "conflict to resolve"
msgstr "conflito a resolver"

#: plugins/dockers/projectsdocker/ProjectsModel.cpp
msgid "Folder not found"
msgstr "Pasta não encontrada"

#: plugins/dockers/projectsdocker/ProjectsModel.cpp
msgid "1 update"
msgid_plural "%1 updates"
msgstr[0] "1 atualização"
msgstr[1] "%1 atualizações"

#: plugins/dockers/projectsdocker/ProjectsModel.cpp
msgid "No changes"
msgstr "Nenhuma alteração"

#: plugins/dockers/projectsdocker/ProjectsModel.cpp
#, kde-format
msgid ""
"%1 has work that was not sent yet. Synchronize before removing it from your "
"choice."
msgstr ""
"%1 tem trabalho que ainda não foi enviado. Sincronize antes de tirar a pasta "
"da sua escolha."

#: plugins/dockers/projectsdocker/ProjectsDock.cpp
#, kde-format
msgid "%1 is editing this file"
msgstr "%1 está editando este arquivo"

#: plugins/versioning/lore/LoreDriverPlugin.cpp
msgid "Lore server"
msgstr "Servidor Lore"

#: plugins/versioning/lore/LoreOperation.cpp
#, kde-format
msgid "The folder %1 is not a downloaded project."
msgstr "A pasta %1 não é um projeto baixado."

#: plugins/versioning/lore/LoreOperation.cpp
msgid "The server could not be reached. Check the connection and try again."
msgstr "Não foi possível falar com o servidor. Verifique a conexão e tente de novo."

#: plugins/versioning/lore/LoreOperation.cpp
msgid "Sign in to the server to continue."
msgstr "Entre no servidor para continuar."

#: plugins/versioning/lore/LoreOperation.cpp
msgid "Your account does not have access to this project."
msgstr "A sua conta não tem acesso a este projeto."

#: plugins/versioning/lore/LoreOperation.cpp
msgid "The project was not found on the server."
msgstr "O projeto não foi encontrado no servidor."

#: plugins/versioning/lore/LoreOperation.cpp
msgid "The server is busy. Try again in a moment."
msgstr "O servidor está ocupado. Tente de novo em instantes."

#: plugins/versioning/lore/LoreFolderListing.cpp
#, kde-format
msgid "Could not list the folders of %1."
msgstr "Não foi possível listar as pastas de %1."

#: plugins/versioning/lore/LoreDriver.cpp
#, kde-format
msgid "Could not sign in to %1."
msgstr "Não foi possível entrar em %1."

#: plugins/versioning/lore/LoreDriver.cpp
msgid "Finish signing in in the browser."
msgstr "Termine de entrar no navegador."

#: plugins/versioning/lore/LoreDriver.cpp
msgid "Could not sign out."
msgstr "Não foi possível sair."

#: plugins/versioning/lore/LoreDriver.cpp
msgid "Could not list the projects on the server."
msgstr "Não foi possível listar os projetos do servidor."

#: plugins/versioning/lore/LoreDriver.cpp
#, kde-format
msgid "Could not download %1."
msgstr "Não foi possível baixar %1."

#: plugins/versioning/lore/LoreDriver.cpp
#, kde-format
msgid "Downloading %1"
msgstr "Baixando %1"

#: plugins/versioning/lore/LoreDriver.cpp
msgid "Could not change the folders kept on this computer."
msgstr "Não foi possível mudar as pastas guardadas neste computador."

#: plugins/versioning/lore/LoreDriver.cpp
msgid "Changing the folders kept on this computer"
msgstr "Mudando as pastas guardadas neste computador"

#: plugins/versioning/lore/LoreDriver.cpp
msgid "Could not read the state of the project."
msgstr "Não foi possível ler o estado do projeto."

#: plugins/versioning/lore/LoreDriver.cpp
#, kde-format
msgid "Could not read the versions of %1."
msgstr "Não foi possível ler as versões de %1."

#: plugins/versioning/lore/LoreDriver.cpp
#, kde-format
msgid "Could not get %1 as it was in that version."
msgstr "Não foi possível obter %1 como estava nessa versão."

#: plugins/versioning/lore/LoreDriver.cpp
#, kde-format
msgid "Could not tell the others that you are editing %1."
msgstr "Não foi possível avisar os outros que você está editando %1."

#: plugins/versioning/lore/LoreDriver.cpp
#, kde-format
msgid "Could not tell the others that you stopped editing %1."
msgstr "Não foi possível avisar os outros que você parou de editar %1."

#: plugins/versioning/lore/LoreDriver.cpp
#, kde-format
msgid "Someone else is already editing %1."
msgstr "Outra pessoa já está editando %1."

#: plugins/versioning/lore/LoreDriver.cpp
msgid "Could not find out who is editing."
msgstr "Não foi possível saber quem está editando."

#: plugins/versioning/lore/LoreSyncOperation.cpp
msgid "Could not synchronize the project."
msgstr "Não foi possível sincronizar o projeto."

#: plugins/versioning/lore/LoreSyncOperation.cpp
msgid ""
"Could not keep your version of the files that both of you changed, so the "
"new versions were not taken. Synchronize again."
msgstr ""
"Não foi possível manter a sua versão dos arquivos que vocês dois alteraram; "
"por isso as novas versões não foram recebidas. Sincronize de novo."

#: plugins/versioning/lore/LoreSyncOperation.cpp
#, kde-format
msgid ""
"Could not keep your version of %1, so the new versions were not taken. "
"Synchronize again."
msgstr ""
"Não foi possível manter a sua versão de %1; por isso as novas versões não "
"foram recebidas. Sincronize de novo."

#: plugins/versioning/lore/LoreSyncOperation.cpp
msgid "Looking for changes"
msgstr "Procurando alterações"

#: plugins/versioning/lore/LoreSyncOperation.cpp
msgid "Preparing your files"
msgstr "Preparando os seus arquivos"

#: plugins/versioning/lore/LoreSyncOperation.cpp
msgid "Creating a version"
msgstr "Criando uma versão"

#: plugins/versioning/lore/LoreSyncOperation.cpp
msgid "Sending your work"
msgstr "Enviando o seu trabalho"

#: plugins/versioning/lore/LoreSyncOperation.cpp
msgid "Receiving the latest versions"
msgstr "Recebendo as versões mais recentes"

#: plugins/versioning/lore/LoreSyncOperation.cpp
#, kde-format
msgid "Could not settle the differences in %1."
msgstr "Não foi possível resolver as diferenças em %1."

#: plugins/versioning/lore/LoreSyncOperation.cpp
#, kde-format
msgid "Settling the differences in %1"
msgstr "Resolvendo as diferenças em %1"
